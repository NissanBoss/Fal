# Que git no cambie los saltos de linea por su cuenta segun quien clone.
* text=auto

# Un .sh con saltos de Windows no arranca en Mac ni en Linux: da el error
# "bad interpreter". Estos van con LF siempre, pase lo que pase.
*.sh text eol=lf

# Los .bat son al reves: quieren CRLF.
*.bat text eol=crlf

# Los programas en Fal y las salidas esperadas, con LF, para que las
# pruebas den lo mismo en cualquier sistema.
*.fal text eol=lf
*.esperado text eol=lf

*.exe binary

# Pistas para Linguist, que es quien decide como cuenta GitHub el codigo
# de un repositorio. Sin esto podria tomar los ejemplos por documentacion
# y no contarlos.
*.fal linguist-detectable=true
ejemplos/*.fal linguist-documentation=false
pruebas/*.fal linguist-documentation=false
docs/*.gif -linguist-detectable
