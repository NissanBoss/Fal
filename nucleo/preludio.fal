# El preludio del nucleo: lo que "fal --nucleo" mete delante de tu programa.
#
# Esta escrito en el mismo Fal que compila, sin trucos: lo que se puede hacer
# aqui se puede hacer en tu sistema. Solo hay una diferencia, que los nombres
# que empiezan por nucleo_ son suyos y tu programa no los puede usar.
#
# "escribe" no pinta en la pantalla: manda el texto por el puerto serie, que
# QEMU enseña en la terminal. La pantalla es tuya; el preludio solo la toca
# para contar por que se paro todo.

# La memoria de texto de la pantalla: 80 por 25 casillas de 2 bytes, la letra
# y el color. Empieza en 0xB8000.
nucleo_pantalla es region con 753664 y 2000 y 2

funcion nucleo_serie con letra
    # Los terminales esperan volver al principio de la linea antes de bajar.
    si letra es 10
        nucleo_serie con 13
    fin
    # El bit 5 del estado (puerto 0x3FD) dice que cabe otra letra.
    mientras ((lee_puerto de 1021) resto 64) es menor que 32
    fin
    pon_en_puerto con 1016 y letra
fin

funcion nucleo_escribe_texto con t
    para cada letra en t
        nucleo_serie con letra
    fin
fin

funcion nucleo_escribe_numero con n
    si n es menor que 0
        nucleo_serie con 45
        nucleo_cifras con n
    si no
        nucleo_cifras con 0 menos n
    fin
fin

# Va en negativo porque el numero mas pequeño no tiene opuesto: darle la
# vuelta se saldria de los 64 bits.
funcion nucleo_cifras con n
    si n es menor que menos 9
        nucleo_cifras con (cociente con n y 10)
    fin
    nucleo_serie con 48 menos (n resto 10)
fin

funcion nucleo_escribe con valor y salto
    etiqueta es nucleo_etiqueta de valor
    si etiqueta es 1
        nucleo_escribe_numero con valor
    si no si etiqueta es 3
        nucleo_escribe_texto con valor
    si no si etiqueta es 2
        si valor
            nucleo_escribe_texto con "verdadero"
        si no
            nucleo_escribe_texto con "falso"
        fin
    si no si etiqueta es 4
        nucleo_escribe_texto con "una region de "
        nucleo_escribe_numero con largo de valor
        nucleo_escribe_texto con " elementos"
    si no
        nucleo_escribe_texto con "nada"
    fin
    si salto
        nucleo_serie con 10
    fin
fin

funcion nucleo_textos_iguales con a y b
    si (largo de a) no es igual a (largo de b)
        devuelve falso
    fin
    i es 1
    mientras i es menor o igual que largo de a
        si (elemento i de a) no es igual a (elemento i de b)
            devuelve falso
        fin
        i es i mas 1
    fin
    devuelve verdadero
fin

# Los avisos cuando algo revienta: por el puerto serie y en la pantalla, en
# blanco sobre rojo para que no se confunda con nada que pinte el sistema.
# nucleo_casilla es por donde va el aviso en la pantalla.
nucleo_casilla es 1

funcion nucleo_panico con mensaje y donde
    nucleo_rojo
    nucleo_di con "X  "
    nucleo_di_valor con mensaje
    nucleo_di con "\n\n"
    nucleo_di con donde
    nucleo_di con "\n"
    congela
fin

# A esta llega lo que el procesador no pudo hacer, y cualquier interrupcion
# que nadie atiende. sitio es la direccion de la instruccion que iba a
# ejecutar, y direccion, la que intentaba tocar si fue un fallo de pagina.
funcion nucleo_excepcion con numero y codigo y sitio y direccion
    nucleo_rojo
    si numero es mayor o igual que 32
        nucleo_di con "X  Ha llegado la interrupcion "
        nucleo_di_valor con numero
        nucleo_di con " y nadie la atiende.\n\n"
        nucleo_di con "Pista: dale una funcion con atiende_interrupcion, o tapala en el controlador de interrupciones.\n"
        congela
    fin
    # Es el tropiezo de siempre: al arrancar, el controlador de
    # interrupciones manda las de los aparatos a la 8 en adelante, encima de
    # las excepciones, y el reloj se hace pasar por un fallo doble. Un
    # aparato no mete codigo de error, asi que en su sitio queda la
    # direccion de vuelta, que es un numero mucho mas grande que cualquier
    # codigo de verdad.
    si numero es mayor o igual que 8 y numero es menor o igual que 15 y codigo es mayor que 65535
        nucleo_di con "X  Ha llegado la interrupcion de un aparato por la "
        nucleo_di_valor con numero
        nucleo_di con ", que es la de una excepcion del procesador.\n\n"
        nucleo_di con "Pista: al arrancar, el controlador de interrupciones manda las de los aparatos de la 8 a la 15. Remapealo para que lleguen de la 32 en adelante antes de activar las interrupciones.\n"
        congela
    fin
    nucleo_di con "X  El procesador se ha parado: "
    nucleo_di con (nucleo_que_excepcion con numero)
    nucleo_di con ".\n\nIba a ejecutar lo que hay en "
    nucleo_di_hex con sitio
    si numero es 14
        nucleo_por_que_pagina con codigo y direccion
    si no si codigo no es igual a 0
        nucleo_di con "\nCodigo de error: "
        nucleo_di_valor con codigo
    fin
    nucleo_di con "\n"
    # El fallo de pagina ya se explica solo: con su codigo no se confunde
    # con un aparato.
    si numero es mayor o igual que 8 y numero es menor o igual que 15 y numero no es igual a 14
        nucleo_di con "\nPista: si acabas de activar las interrupciones, puede que no sea un fallo sino un aparato. Remapea el controlador de interrupciones para que las suyas lleguen de la 32 en adelante.\n"
    fin
    congela
fin

# Un fallo de pagina dice en su codigo que paso: el bit 0, si la pagina
# existia (y entonces fue por permisos); el 1, si era una escritura; el 4, si
# iba a ejecutarla. Con las tablas que monta el sistema, esto es lo que
# cuenta que el procesador ha parado algo que no debia pasar.
funcion nucleo_por_que_pagina con codigo y direccion
    si (codigo resto 2) es 0
        nucleo_di con "\ny quiso tocar la direccion "
        nucleo_di_hex con direccion
        nucleo_di con ", que no existe."
    si no si ((cociente con codigo y 16) resto 2) es 1
        nucleo_di con "\ny quiso ejecutar lo que hay en "
        nucleo_di_hex con direccion
        nucleo_di con ", que no es codigo: son datos, y los datos no se ejecutan."
    si no si ((cociente con codigo y 2) resto 2) es 1
        nucleo_di con "\ny quiso escribir en "
        nucleo_di_hex con direccion
        nucleo_di con ", que es de solo lectura."
    si no
        nucleo_di con "\ny quiso leer "
        nucleo_di_hex con direccion
        nucleo_di con ", y no tiene permiso."
    fin
fin

funcion nucleo_que_excepcion con n
    si n es 0
        devuelve "division entre cero"
    si no si n es 1
        devuelve "depuracion"
    si no si n es 2
        devuelve "interrupcion no enmascarable"
    si no si n es 3
        devuelve "punto de parada"
    si no si n es 4
        devuelve "desbordamiento"
    si no si n es 5
        devuelve "fuera de limites"
    si no si n es 6
        devuelve "instruccion que no existe"
    si no si n es 7
        devuelve "no hay coprocesador"
    si no si n es 8
        devuelve "fallo doble"
    si no si n es 10
        devuelve "segmento de tarea no valido"
    si no si n es 11
        devuelve "segmento que no esta"
    si no si n es 12
        devuelve "fallo de la pila"
    si no si n es 13
        devuelve "fallo general de proteccion"
    si no si n es 14
        devuelve "fallo de pagina"
    si no si n es 16
        devuelve "error de coma flotante"
    si no si n es 17
        devuelve "acceso sin alinear"
    si no si n es 18
        devuelve "fallo de la maquina"
    si no si n es 19
        devuelve "error de coma flotante SIMD"
    fin
    devuelve "excepcion reservada"
fin

# Prepara la pantalla roja. Lo primero es cerrar las interrupciones: lo
# que estuviera atendiendolas podria pintar encima del aviso.
funcion nucleo_rojo
    comparte nucleo_casilla
    desactiva_interrupciones
    nucleo_vuelve_al_texto
    para cada casilla desde 1 hasta 2000
        elemento casilla de nucleo_pantalla es 20256
    fin
    # El cursor parpadeando encima del aviso despista: se apaga con el
    # registro 0x0A del controlador de la pantalla.
    pon_en_puerto con 980 y 10
    pon_en_puerto con 981 y 32
    nucleo_casilla es 163
    nucleo_serie con 10
fin

# Si el sistema dejo la pantalla en modo grafico, el aviso seria invisible y un
# nucleo parado pareceria colgado. La tarjeta de QEMU apaga los graficos por el
# registro 4, pero no devuelve sola lo que toco al encenderlos.
funcion nucleo_vuelve_al_texto
    pon_palabra con 462 y 4
    encendida es lee_palabra de 463
    si encendida es 65535 o (encendida resto 2) es 0
        devuelve nada
    fin
    pon_palabra con 463 y 0
    nucleo_registro con 964 y 1 y 0
    nucleo_registro con 964 y 4 y 2
    nucleo_registro con 974 y 5 y 16
    nucleo_registro con 974 y 6 y 14
    nucleo_registro con 980 y 17 y 14
    nucleo_registro con 980 y 1 y 79
    nucleo_registro con 980 y 7 y 31
    nucleo_registro con 980 y 9 y 79
    nucleo_registro con 980 y 18 y 143
    nucleo_registro con 980 y 19 y 40
    nucleo_registro con 980 y 23 y 163
    nucleo_registro con 980 y 24 y 255
fin

funcion nucleo_registro con puerto y cual y valor
    pon_en_puerto con puerto y cual
    pon_en_puerto con puerto mas 1 y valor
fin

# Una letra al puerto serie y a la pantalla. La pantalla no habla UTF-8 sino
# la pagina de codigos 437 de IBM, donde una letra con tilde es un byte y no
# dos: se guarda el primero y se traduce al llegar el segundo. Los avisos
# salian con "p?gina", y un aviso en castellano tiene que poder leerse.
nucleo_a_medias es 0

funcion nucleo_letra con letra
    comparte nucleo_casilla y nucleo_a_medias
    nucleo_serie con letra
    si letra es 10
        nucleo_casilla es nucleo_baja con nucleo_casilla
    si no si nucleo_casilla es mayor que 2000
        nucleo_casilla es nucleo_casilla
    si no si letra es menor que 128
        nucleo_pon con letra
    si no si letra es mayor o igual que 192
        nucleo_a_medias es letra
    si no si nucleo_a_medias no es igual a 0
        nucleo_pon con (nucleo_437 con nucleo_a_medias y letra)
        nucleo_a_medias es 0
    fin
fin

funcion nucleo_pon con letra
    comparte nucleo_casilla
    elemento nucleo_casilla de nucleo_pantalla es 20224 mas letra
    nucleo_casilla es nucleo_casilla mas 1
fin

# Lo que tiene la 437 de lo que se escribe en castellano. Las mayusculas con
# tilde no estan, salvo la E: salen sin ella. Lo demas, ?.
funcion nucleo_437 con primero y segundo
    si primero es 195
        si segundo es 161
            devuelve 160
        si no si segundo es 169
            devuelve 130
        si no si segundo es 173
            devuelve 161
        si no si segundo es 179
            devuelve 162
        si no si segundo es 186
            devuelve 163
        si no si segundo es 177
            devuelve 164
        si no si segundo es 145
            devuelve 165
        si no si segundo es 188
            devuelve 129
        si no si segundo es 156
            devuelve 154
        si no si segundo es 137
            devuelve 144
        si no si segundo es 129
            devuelve 65
        si no si segundo es 141
            devuelve 73
        si no si segundo es 147
            devuelve 79
        si no si segundo es 154
            devuelve 85
        fin
    si no si primero es 194
        si segundo es 191
            devuelve 168
        si no si segundo es 161
            devuelve 173
        si no si segundo es 171
            devuelve 174
        si no si segundo es 187
            devuelve 175
        fin
    fin
    devuelve 63
fin

# En la pantalla las lineas se parten por las palabras, con el mismo margen
# a la izquierda. Por el puerto serie no: ahi lo parte el terminal.
funcion nucleo_di con t
    comparte nucleo_casilla
    i es 1
    mientras i es menor o igual que largo de t
        letra es elemento i de t
        si letra es 32 y ((nucleo_casilla menos 1) resto 80) mas (nucleo_palabra con t y i mas 1) es mayor que 76
            nucleo_serie con 32
            nucleo_casilla es nucleo_baja con nucleo_casilla
        si no
            nucleo_letra con letra
        fin
        i es i mas 1
    fin
fin

funcion nucleo_di_valor con valor
    etiqueta es nucleo_etiqueta de valor
    si etiqueta es 3
        nucleo_di con valor
    si no si etiqueta es 1
        si valor es menor que 0
            nucleo_letra con 45
            nucleo_di_cifras con valor y 10
        si no
            nucleo_di_cifras con 0 menos valor y 10
        fin
    si no
        nucleo_di con "(un valor que no es un texto)"
    fin
fin

funcion nucleo_di_hex con n
    nucleo_di con "0x"
    nucleo_di_cifras con 0 menos n y 16
fin

# Como nucleo_cifras, en negativo, y en la base que se pida.
funcion nucleo_di_cifras con n y base
    si n es menor o igual que 0 menos base
        nucleo_di_cifras con (cociente con n y base) y base
    fin
    cifra es 0 menos (n resto base)
    si cifra es menor que 10
        nucleo_letra con 48 mas cifra
    si no
        nucleo_letra con 55 mas cifra
    fin
fin

funcion nucleo_baja con p
    devuelve ((cociente con (p menos 1) y 80) mas 1) por 80 mas 6
fin

# Lo que mide la palabra que empieza en la posicion i.
funcion nucleo_palabra con t y i
    n es 0
    mientras i mas n es menor o igual que largo de t
        letra es elemento i mas n de t
        si letra es 32 o letra es 10
            devuelve n
        fin
        n es n mas 1
    fin
    devuelve n
fin
