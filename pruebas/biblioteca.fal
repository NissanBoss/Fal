escribe busca con "tel 600111222 y 600333444" y "[0-9]{9}"
escribe cambia con "hoy es 2026-07-31" y "[0-9]{4}" y "AAAA"

escribe "-- CSV --"
filas es tabla de "nombre,edad\nAna,30\nLuis,22"
