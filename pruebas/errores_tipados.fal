intenta
    escribe lee de "no_existe.txt"
si falla de matematica
    escribe "no deberia entrar aqui"
si falla de archivo
    escribe "archivo: " mas mensaje de error
    escribe "clase: " mas clase de error
fin

funcion arriesga
    intenta
        falla "algo mio"
    si falla
        escribe "lo vi pasar, lo relanzo"
        relanza
    fin
fin
intenta
    arriesga
si falla de programa
    escribe "capturado fuera: " mas error
fin

