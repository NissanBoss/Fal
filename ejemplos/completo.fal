escribe ""
escribe "=== FUNCIONES Y RECURSION ==="

funcion factorial con n
    si n es menor o igual que 1
        devuelve 1
    fin
    devuelve n por factorial con (n menos 1)
fin

para cada i desde 1 hasta 6
    escribe i mas "! = " mas factorial con i
fin

funcion es_primo con n
    si n es menor que 2
        devuelve falso
    fin
    para cada d desde 2 hasta n
        si d por d es mayor que n
            detente
        fin
        si n resto d es 0
            devuelve falso
        fin
    fin
    devuelve verdadero
fin

primos es lista vacia
para cada n desde 1 hasta 40
    si es_primo con n
        agrega n a primos
    fin
fin
escribe "Primos hasta 40: " mas primos

