ABECEDARIO es "abcdefghijklmnopqrstuvwxyz"

MENSAJE es "ataca al amanecer por el flanco este"
CLAVE es 7

funcion cifra con frase y salto
    salida es ""
    para cada letra en minusculas de frase
        donde es posicion de ABECEDARIO con letra
        si donde es 0
            salida es salida mas letra
        si no
            destino es ((donde menos 1 mas salto) resto 26) mas 1
            salida es salida mas (elemento destino de ABECEDARIO)
        fin
    fin
    devuelve salida
fin

funcion descifra con frase y salto
    devuelve cifra con frase y (26 menos salto)
fin

funcion puntua con frase
    puntos es 0
    para cada palabra en (lista con " de " y " la " y " el " y " en " y " un " y " por ")
        puntos es puntos mas (cuenta de frase con palabra)
    fin
    devuelve puntos
fin

secreto es cifra con MENSAJE y CLAVE

escribe "Mensaje:  " mas MENSAJE
escribe "Cifrado:  " mas secreto
escribe "Y vuelta: " mas (descifra con secreto y CLAVE)
escribe

mejor es 0
clave_buena es 0
para cada salto desde 1 hasta 25
    puntos es puntua con (descifra con secreto y salto)
    si puntos es mayor que mejor
        mejor es puntos
        clave_buena es salto
    fin
fin

escribe "Probando las 25 claves posibles:"
escribe
para cada salto desde 1 hasta 25
    marca es "    "
    si salto es clave_buena
        marca es " -> "
    fin
    escribe marca mas (descifra con secreto y salto)
fin

escribe
escribe "La clave era " mas texto de clave_buena mas ", y ha salido sola."
escribe "Por eso un cifrado con 25 claves no sirve para nada."
